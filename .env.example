# Получить в @BotFather. Не добавлять в Git и не вставлять в браузер.
BOT_TOKEN=
# Публичный HTTPS-адрес, по которому работают и приложение, и его API.
APP_URL=https://your-domain.example
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/misis.sqlite
# Запуск одного экземпляра бота; в тестах и локальном демо выключен.
BOT_ENABLED=false
# Для Docker Compose: домен без https:// (DNS должен указывать на сервер).
APP_DOMAIN=your-domain.example
# Только для запуска вне Docker; Python с xlrd и openpyxl.
PYTHON_BIN=python3

# Необязательно: постоянный каталог расписаний, по умолчанию рядом с базой.
# MISIS_CATALOG_PATH=./data/misis-data.json
